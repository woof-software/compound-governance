# Ethereum RPC endpoint URL for connecting to the blockchain network
# Examples: https://mainnet.infura.io/v3/YOUR_PROJECT_ID, https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY
# Required for running hardhat tests
RPC_URL=

# Etherscan API key for contract verification and interaction
# Get your API key from: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Ethereum address of the account that will deploy contracts
# This should be a funded address with enough ETH for gas fees
DEPLOYER_ADDRESS=

# Private key of the deployer account (without 0x prefix)
# WARNING: Never commit this to version control in production!
# This is only for local development and testing
DEPLOYER_PRIVATE_KEY=

